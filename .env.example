# Copy this file to .env and fill in real values.
# The fastest way: run `npm run setup` and it will generate .env for you.
# NEVER commit the real .env file.

# --- Server ---
NODE_ENV=development
PORT=3000

# Public base URL of the site (used for canonical links / meta tags)
SITE_URL=http://localhost:3000

# --- Admin account (only you) ---
ADMIN_USERNAME=YOUR_ADMIN_USERNAME_HERE

# bcrypt hash of your password. Generate with: npm run hash-password
# Plain-text passwords are never stored or accepted here.
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH_HERE

# --- Sessions ---
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET_HERE

# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false

# --- Storage paths (override when using a mounted volume) ---
DATA_DIR=./data
UPLOAD_DIR=./uploads

# --- Upload limits (bytes) ---
MAX_IMAGE_BYTES=5242880
MAX_DOC_BYTES=10485760

# Comma separated list of allowed origins for state-changing requests.
# Leave empty to allow only same-origin requests derived from SITE_URL.
TRUSTED_ORIGINS=
